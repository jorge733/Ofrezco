# Copia este archivo como functions/.env y completa los valores. functions/.env NO se sube a GitHub.

# "flow-sandbox" (pruebas) o "flow-produccion" (dinero real). Vacío: la tienda no abre pagos.
PAGOS_MODO=

# Claves de Flow: Integraciones → Integración por API
FLOW_API_KEY=
FLOW_SECRET=

# Escribe "si" solo cuando decidas cobrar dinero real con flow-produccion
COBROS_REALES_APROBADOS=

SITIO=https://www.serviceplanet.cl
