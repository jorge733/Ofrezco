rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Enlaces únicos: cualquiera puede leerlos, solo el dueño puede crearlos o borrarlos.
    // "create" falla si el enlace ya existe, así nadie puede quitarle el suyo a otra persona.
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && slug.matches('^[a-z0-9-]{3,40}$');
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Perfiles y productos: públicos para leer, solo el dueño puede escribir.
    match /perfiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;

      match /productos/{productoId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
